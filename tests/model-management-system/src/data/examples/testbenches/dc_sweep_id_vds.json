{
  "testbench_id": "TB_DC_001",
  "name": "DC Sweep - Id vs Vds Characteristics",
  "description": "Testbench for measuring drain current versus drain-source voltage at different gate voltages",
  "type": "dc_sweep",
  "category": "DC",
  "version": "1.0",
  
  "circuit": {
    "netlist": [
      "* DC Sweep Testbench for Id-Vds Characteristics",
      ".param vdd=1.8",
      ".param vgs_val=0.9",
      ".param w_val=10u",
      ".param l_val=0.18u",
      "",
      "* DUT (Device Under Test)",
      "M1 drain gate 0 0 nmos_model W={w_val} L={l_val}",
      "",
      "* Voltage Sources",
      "Vgs gate 0 DC {vgs_val}",
      "Vds drain 0 DC 0",
      "",
      "* DC Sweep Analysis",
      ".dc Vds 0 {vdd} 0.01 Vgs 0.3 1.3 0.2",
      "",
      "* Output",
      ".print dc i(Vds)",
      ".end"
    ],
    "parameters": {
      "vdd": {
        "default": 1.8,
        "unit": "V",
        "description": "Supply voltage"
      },
      "vgs_val": {
        "default": 0.9,
        "unit": "V",
        "description": "Gate-source voltage"
      },
      "w_val": {
        "default": 10e-6,
        "unit": "m",
        "description": "Transistor width"
      },
      "l_val": {
        "default": 0.18e-6,
        "unit": "m",
        "description": "Transistor length"
      }
    }
  },
  
  "simulation_settings": {
    "analysis_type": "DC",
    "sweep_variable": "Vds",
    "sweep_range": {
      "start": 0,
      "stop": 1.8,
      "step": 0.01
    },
    "nested_sweep": {
      "variable": "Vgs",
      "start": 0.3,
      "stop": 1.3,
      "step": 0.2
    },
    "temperature": 27,
    "convergence": {
      "reltol": 1e-3,
      "abstol": 1e-12,
      "vntol": 1e-6
    }
  },
  
  "measurements": [
    "measure dc id_max max i(Vds)",
    "measure dc id_sat find i(Vds) when v(drain)=1.0",
    "measure dc vdsat when d(i(Vds))/d(v(drain)) < 0.01*id_max",
    "measure dc ron param='v(drain)/i(Vds)' when v(drain)=0.1",
    "measure dc gm deriv i(Vds) wrt v(gate)"
  ],
  
  "outputs": {
    "id": {
      "unit": "A",
      "description": "Drain current"
    },
    "vds": {
      "unit": "V",
      "description": "Drain-source voltage"
    },
    "gm": {
      "unit": "S",
      "description": "Transconductance"
    },
    "ron": {
      "unit": "Ohm",
      "description": "On-resistance"
    },
    "vdsat": {
      "unit": "V",
      "description": "Saturation voltage"
    }
  },
  
  "compatible_devices": ["NMOS", "PMOS"],
  "compatible_models": ["BSIM4", "PSP", "EKV"],
  
  "validation": {
    "validated": true,
    "validation_date": "2024-01-10",
    "validated_by": "Test Engineering"
  },
  
  "examples": [
    {
      "name": "NMOS Id-Vds Sweep",
      "description": "Basic NMOS transistor characterization",
      "netlist": [
        ".param vdd=1.8",
        ".param w_val=10u",
        ".param l_val=0.18u",
        "M1 drain gate 0 0 nmos_180nm W={w_val} L={l_val}",
        "Vgs gate 0 DC 0.9",
        "Vds drain 0 DC 0",
        ".dc Vds 0 1.8 0.01",
        ".print dc i(Vds)",
        ".end"
      ]
    }
  ],
  
  "tags": ["dc-sweep", "id-vds", "characterization", "mosfet", "validated"],
  
  "author": {
    "name": "Test Team",
    "email": "test@example.com",
    "department": "Device Characterization"
  },
  
  "schematic": "dc_sweep_schematic.svg",
  "documentation_url": "https://docs.example.com/testbenches/dc-sweep",
  
  "timestamps": {
    "created": "2024-01-10T10:00:00Z",
    "modified": "2024-01-15T14:30:00Z"
  }
}