{
  "name": "aivalanche-desktop",
  "version": "0.1.0",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "cross-env SKIP_BACKEND=1 NODE_ENV=development electron .",
    "pack": "electron-builder"
  },
  "dependencies": {
    "electron": "^28.1.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron-builder": "^24.11.0"
  },
  "build": {
    "asar": true,
    "files": [
      "../frontend/dist/**/*",
      "main.js",
      "../backend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend/dist/aivalanche_backend*",
        "to": "aivalanche_backend"
      }
    ],
    "directories": {
      "output": "dist"
    }
  }
} 