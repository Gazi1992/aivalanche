  begin <FPScanNode(1.3)> "Length Scanner"
       "1x2 MMI - AlGaAs" //cdname1
       20 //nstep
       180 220 //xstart,xend
       "l2" //xlabel
       20 //n2step
       0 1 //x2start,x2end
       "x2-parameter" //x2label
       0 //storeSmat
       0 //scannermode
       0 //paramScanMode
  end
  begin <notesTB(1.0)> "Notes"
    >Kallistos AI Tests - MMI
    >===================================
    >Optimise output power of frequency domain device with 8 variables.
    >Repeat optimisation from multiple start positions to give evidence of a global maxima. I expect
    >this device will have lots of local maxima 
    >
    >
    >Variables
    >==========
    >w2 - Width of leftmost waveguide on its right side and rightmost waveguides on their left side
    >w3 - Width of central section (sides)
    >w4 - Width of central section (center)
    >l1 - Length of leftmost waveguide
    >l2 - Length of central section
    >l3 - Length of rightmost waveguides
    >d1 - Separation of rightmost waveguides on their left side
    >
    >
    >Constraints
    >===========
    >w1 = 1.5  - Width of leftmost waveguide on its left side and rightmost waveguides 
    >            on their right side
    >d2 = 10 - Separation of rightmost waveguides on their right side
    >
    >
    >Useful Commands
    >===============
    >
    >app.subnodes[1].subnodes[2].cdev.smat.lr[1][1]
    >Important output of our simulation. This complex value squared is our optimisation goal.
    >We're looking to get this as close to 0.5 as possible.
    >
    >app.subnodes[1].subnodes[2].update()
    >Recalculates the output (note this will be slow if variables are changed other than lengths which 
    >simulate quickly)
    >
    >app.subnodes[1].subnodes[1].setvariable(X,"Y")
    >Changes the variable X to a value of Y such as app.subnodes[1].subnodes[1].setvariable(w2,"2.6")
    >
    >
    >NOTE: When a simulation is done, scanning the length of each section (variables l1 and l2) 
    >is VERY fast (0.2s each simulation). If any modification can be done to the algorithm to 
    >acount for this there will be a large computational advantage.
    >
    >Useful UI Elements
    >==================
    >
    >Run simulation - 8th from left on FIMMPROP tool bar
    >Plot field - 11th from left on FIMMPROP Toolbar
    >Kallistos Settings - 3rd from left on Kallistos Toolbar (find upper and lower bounds here)
    >Run Optimisation - 5th from left on Kallistos Toolbar
    >
    >
    >From my initial investigation using scans this is a good result with output = 0.476
    >w2 = 2.6, w3 = 10, w4 = 14.9, l1 = 516, l2 = 875, d1 = 5, l3 = 515.7
    >
    >
  end
  begin <FPOptimiser(1.2)> "KALLISTOS optimiser 1"
    PRJITEMNAME : "1x2 MMI - AlGaAs"
    PRECISION : 0.0001
    MAXFUNCEVALS : 0
    MAXIMISE : 1
    OPTMETHOD : 1
    OBJFUNCTYPE : Maximise Mode Output
    ANALYTICMETHOD : 0
    BOXSIZE : 0.000000
    INDEPENDENTVAR : w2 1 5 1.5
    INDEPENDENTVAR : w3 5 15 10
    INDEPENDENTVAR : w4 10 20 10
    INDEPENDENTVAR : l1 10 1000 500
    INDEPENDENTVAR : l2 10 1000 200
    INDEPENDENTVAR : l3 10 1000 500
    INDEPENDENTVAR : d1 0 10 5
    begin <FPOptimiserObjFuncData(1.0)> "Maximise Mode Output"
      CALC_COMMAND : "calcoutputfield(3,1)" 
      CALC_COMMAND : "calcmodepower(1)" a1
      OBJECTIVE : a1
    end
  end
end
